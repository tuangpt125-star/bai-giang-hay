---
interface Props { caption?: string }
const { caption = 'Mạch điện đơn giản' } = Astro.props;
---
<figure class="circuit" data-circuit data-closed="true">
  <svg viewBox="0 0 480 215" role="img" aria-labelledby="circuit-title">
    <title id="circuit-title">Pin ở bên trái, bóng đèn ở bên phải và công tắc trên đường dây phía dưới.</title>
    <rect x="1" y="1" width="478" height="213" rx="16" fill="#f1f8fa" />
    <path class="wire" d="M70 65V51q0-16-16-16H42q-18 0-18 18v107q0 22 23 22h107m69 0h38q21 0 21-22v-27q0-14 14-14h25M152 64V42q0-17 18-17h254q22 0 22 22v65q0 18-18 18h-16q-15 0-15-15v-15q0-13-13-13h-13v32h-15" />
    <path class="wire-flow reverse" d="M70 65V51q0-16-16-16H42q-18 0-18 18v107q0 22 23 22h107 69 38q21 0 21-22v-27q0-14 14-14h25" />
    <path class="wire-flow" d="M152 64V42q0-17 18-17h254q22 0 22 22v65q0 18-18 18h-16q-15 0-15-15v-15q0-13-13-13h-13v32h-15" />
    <rect x="59" y="69" width="105" height="34" rx="5" fill="#416b83" />
    <rect x="70" y="56" width="82" height="26" rx="12" fill="#d59661" />
    <path d="M83 60h54" stroke="#ebc199" stroke-width="3" stroke-linecap="round" />
    <text x="68" y="120">−</text><text x="144" y="120">+</text>
    <text x="111" y="138" text-anchor="middle">Pin</text>

    <rect x="306" y="119" width="66" height="24" rx="3" fill="#728e48" />
    <circle class="halo" cx="339" cy="93" r="32" fill="#ffe395" opacity=".55" />
    <path d="M328 114v-7a16 16 0 1 1 22 0v7" class="bulb" stroke="#725329" stroke-width="2" />
    <path d="m335 109-3-14 7 4 7-4-3 14m-16 5h24v10h-24Z" stroke="#725329" stroke-width="2" fill="none" />
    <path d="M321 119h6m24 0h5" stroke="#30627c" stroke-width="3" />
    <circle cx="321" cy="119" r="4" fill="#30627c" />
    <circle cx="356" cy="119" r="4" fill="#30627c" />
    <text x="339" y="165" text-anchor="middle">Bóng đèn</text>

    <rect x="143" y="185" width="92" height="9" rx="3" fill="#564832" />
    <path class="lever" d="M154 182h69" stroke="#a9632d" stroke-width="6" stroke-linecap="round" />
    <circle cx="154" cy="182" r="6" fill="#c48143" />
    <circle cx="223" cy="182" r="5" fill="#c48143" />
    <text x="188" y="163" text-anchor="middle">Công tắc</text>
  </svg>
  <figcaption>{caption}</figcaption>
  <div class="diagram-controls" data-controls hidden>
    <button type="button" aria-pressed="true">Công tắc đóng</button>
    <output aria-live="polite">Mạch kín · Đèn sáng</output>
  </div>
</figure>
<script>
  for (const diagram of document.querySelectorAll<HTMLElement>('[data-circuit]')) {
    const controls = diagram.querySelector<HTMLElement>('[data-controls]')!;
    const button = controls.querySelector('button')!;
    const result = controls.querySelector('output')!;
    controls.hidden = false;
    button.addEventListener('click', () => {
      const closed = diagram.dataset.closed !== 'true';
      diagram.dataset.closed = String(closed);
      button.setAttribute('aria-pressed', String(closed));
      button.textContent = closed ? 'Công tắc đóng' : 'Công tắc mở';
      result.value = closed ? 'Mạch kín · Đèn sáng' : 'Mạch hở · Đèn tắt';
    });
  }
</script>
<style>
  .circuit { margin: 1.15rem 0; text-align: center; }
  svg { display: block; width: min(100%, 38rem); margin-inline: auto; }
  svg text { fill: #264254; font: 600 16px system-ui; }
  .wire, .wire-flow { fill: none; stroke: #30627c; stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; }
  .wire-flow { stroke: #83cbd9; stroke-width: 2; stroke-dasharray: 3 12; animation: current 1.15s linear infinite; }
  .wire-flow.reverse { animation-direction: reverse; }
  .bulb { fill: #ffde74; }
  .lever { transform-origin: 154px 182px; transition: transform .2s; }
  [data-closed="false"] .lever { transform: rotate(-25deg); }
  [data-closed="false"] .wire-flow, [data-closed="false"] .halo { visibility: hidden; }
  [data-closed="false"] .bulb { fill: #e5eaf0; }
  .diagram-controls { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .6rem 1rem; margin-top: .65rem; }
  button { min-height: 2.75rem; padding: .4rem .75rem; border: 1px solid #8975b9; border-radius: .5rem; color: #402174; background: #f0e9fa; }
  output { font-weight: 650; color: #274a59; }
  @keyframes current { to { stroke-dashoffset: 15; } }
  @media (prefers-reduced-motion: reduce) { .wire-flow { animation: none; } .lever { transition: none; } }
</style>
