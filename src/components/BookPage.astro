---
interface Props {
  number: number;
  image: string;
  original: string;
}

const { number, image, original } = Astro.props;
---
<details class="book-page" id={`ban-in-${number}`}>
  <summary>Hình, bảng và bản in trang {number}</summary>
  <div class="book-page-content">
    <a class="original-link" href={original} target="_blank" rel="noopener">Mở trang {number} trong sách gốc</a>
    <a class="book-page-image" href={image} target="_blank" rel="noopener" aria-label={`Mở ảnh trang ${number} ở kích thước gốc`}>
      <img src={image} width="1272" height="1800" loading="lazy" decoding="async" alt={`Bản in sách giáo khoa, trang ${number}`} />
    </a>
  </div>
</details>
