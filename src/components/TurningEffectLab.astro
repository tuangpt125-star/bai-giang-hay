---
import '../styles/measurement-lab.css';
---
<section class="measurement-lab" data-turning-effect hidden aria-labelledby="turning-effect-title">
  <h3 id="turning-effect-title">Thí nghiệm ảo · Kéo thanh bằng lực kế</h3>
  <p>Kéo chốt trên thanh để chọn lỗ móc. Sau đó nắm vòng đỏ ở đầu lực kế và kéo ra xa chốt. Quan sát số chỉ khi giữ kéo, rồi nhả tay xem thanh chuyển động thế nào.</p>
  <figure class="turning-figure">
    <div class="lab-board">
      <canvas width="560" height="350" data-turning-diagram aria-hidden="true"></canvas>
      <button type="button" class="lab-grab" data-grab-position aria-label="Điểm đặt lực. Dùng mũi tên trái hoặc phải để đổi lỗ móc." title="Đổi lỗ móc"></button>
      <button type="button" class="lab-grab" data-grab-force aria-label="Tay cầm lực kế. Giữ và kéo, hoặc bấm Enter để bật và nhả lực." title="Giữ và kéo lực kế"></button>
    </div>
    <figcaption>Lực kế màu vàng nối với chốt. Mũi tên đỏ chỉ chiều lực kéo, song song với giá lực nét đứt. Đoạn tím đi vuông góc từ O đến giá lực.</figcaption>
  </figure>
  <div class="lab-actions">
    <button type="button" data-turning-try>Tác dụng lực đã đặt</button>
    <button type="button" data-turning-reset disabled>Đưa thanh về ngang</button>
  </div>
  <p class="lab-trial-status" role="status" data-turning-trial>Thanh ngang. Em có thể thử dự đoán trước khi kéo.</p>
  <div class="lab-layout">
    <div class="lab-controls">
      <label for="turning-force">Lực đặt trước <output for="turning-force" data-turning-force>10 N</output></label>
      <input id="turning-force" type="range" min="5" max="20" step="5" value="10" />
      <label for="turning-position">Lỗ móc lực kế <output for="turning-position" data-turning-position>30 cm bên phải O</output></label>
      <input id="turning-position" type="range" min="-25" max="50" step="5" value="30" />
      <label for="turning-angle">Hướng lực đặt trước <output for="turning-angle" data-turning-angle>90°</output></label>
      <input id="turning-angle" type="range" min="-90" max="90" step="15" value="90" />
      <p class="lab-help">0° hướng ngang sang phải. Các thanh điều chỉnh dùng để chuẩn bị hoặc thử bằng bàn phím.</p>
    </div>
    <div class="lab-panel">
      <p><strong data-turning-readout>Dự đoán ở vị trí ngang</strong></p>
      <dl class="lab-values">
        <div><dt>Lực kéo</dt><dd><output data-turning-tension>10 N</output></dd></div>
        <div><dt>Cánh tay đòn d</dt><dd><output data-turning-arm>30 cm</output></dd></div>
        <div><dt>Độ lớn moment</dt><dd><output data-turning-moment>3 N·m</output></dd></div>
        <div><dt>Tác dụng của lực lúc này</dt><dd><output data-turning-direction>Ngược chiều kim đồng hồ</output></dd></div>
      </dl>
    </div>
  </div>
  <p class="lab-help">Thanh có quán tính và ma sát ở chốt. Khi nhả lực, thanh có thể quay tiếp một lúc rồi chậm dần hoặc chạm cữ chặn.</p>
</section>

<script>
  import { arrow, dragHandle, line, positionHandle, spring } from '../physics/lab-diagram';
  import { rotationLab, stopAngle, type Rotation } from '../physics/rotation';

  const format = new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 2 });
  const ox = 178;
  const oy = 174;
  const pixelsPerCm = 4.7;
  const slack = 52;
  const extensionPerNewton = 2.2;

  for (const lab of document.querySelectorAll<HTMLElement>('[data-turning-effect]')) {
    const find = <T extends HTMLElement>(selector: string) => lab.querySelector<T>(selector)!;
    const force = find<HTMLInputElement>('#turning-force');
    const position = find<HTMLInputElement>('#turning-position');
    const angle = find<HTMLInputElement>('#turning-angle');
    const canvas = find<HTMLCanvasElement>('[data-turning-diagram]');
    const context = canvas.getContext('2d');
    const hookHandle = find<HTMLButtonElement>('[data-grab-position]');
    const meterHandle = find<HTMLButtonElement>('[data-grab-force]');
    const apply = find<HTMLButtonElement>('[data-turning-try]');
    const reset = find<HTMLButtonElement>('[data-turning-reset]');
    const status = find<HTMLElement>('[data-turning-trial]');
    let live = false;
    let forceOn = false;
    let hand: { x: number; y: number } | null = null;

    if (!context) canvas.closest('figure')!.hidden = true;

    function appliedForce(tilt: number) {
      const centimetres = position.valueAsNumber;
      const rx = Math.cos(tilt) * centimetres * pixelsPerCm;
      const ry = Math.sin(tilt) * centimetres * pixelsPerCm;
      const x = ox + rx;
      const y = oy + ry;
      const direction = angle.valueAsNumber * Math.PI / 180;
      const ux = hand ? hand.x - x : Math.cos(direction);
      const uy = hand ? hand.y - y : -Math.sin(direction);
      const norm = Math.hypot(ux, uy) || 1;
      const tension = hand
        ? Math.min(20, Math.max(0, (norm - slack) / extensionPerNewton))
        : forceOn || !live ? force.valueAsNumber : 0;
      const length = hand ? norm : slack + (forceOn ? tension * extensionPerNewton : 0);
      const unitX = ux / norm;
      const unitY = uy / norm;
      const arm = (rx * unitY - ry * unitX) / pixelsPerCm;
      return { x, y, rx, ry, unitX, unitY, tension, length, arm, torque: tension * arm / 100 };
    }

    function render({ angle: tilt, speed }: Rotation) {
      const pull = appliedForce(tilt);
      const pen = context;
      const { x, y, unitX: ux, unitY: uy } = pull;
      const headX = Math.min(542, Math.max(18, x + ux * pull.length));
      const headY = Math.min(332, Math.max(18, y + uy * pull.length));
      const hasTension = pull.tension > .005;
      const netTorque = Math.abs(pull.torque) < .0001 ? 0 : pull.torque;
      hookHandle.hidden = Boolean(hand || forceOn || Math.abs(speed) > .02);
      positionHandle(hookHandle, canvas, x, y);
      positionHandle(meterHandle, canvas, hand ? hand.x : headX, hand ? hand.y : headY);

      if (pen) {
        const dx = Math.cos(tilt);
        const dy = Math.sin(tilt);
        pen.clearRect(0, 0, canvas.width, canvas.height);
        pen.lineCap = 'round';
        line(pen, 42, 274, 454, 274, '#c7d3e2', 4);
        for (const stop of [-115, 204]) {
          const drop = Math.abs(stop) * Math.sin(stopAngle);
          line(pen, ox + stop, oy + drop + 9, ox + stop, 270, '#9b6b50', 12);
        }
        pen.fillStyle = '#53617c';
        pen.beginPath();
        pen.moveTo(ox, oy);
        pen.lineTo(ox - 47, 271);
        pen.lineTo(ox + 47, 271);
        pen.closePath();
        pen.fill();
        line(pen, ox - 132 * dx, oy - 132 * dy, ox + 248 * dx, oy + 248 * dy, '#506580', 16);
        line(pen, ox - 132 * dx, oy - 132 * dy - 4, ox + 248 * dx, oy + 248 * dy - 4, '#8194ae', 3);
        pen.fillStyle = '#e0e6ef';
        for (let distance = -25; distance <= 50; distance += 5) {
          const offset = distance * pixelsPerCm;
          pen.beginPath();
          pen.arc(ox + offset * dx, oy + offset * dy, 3, 0, Math.PI * 2);
          pen.fill();
        }

        if (hasTension) {
          const projection = pull.rx * ux + pull.ry * uy;
          const footX = x - projection * ux;
          const footY = y - projection * uy;
          pen.setLineDash([7, 6]);
          line(pen, x - 400 * ux, y - 400 * uy, x + 400 * ux, y + 400 * uy, '#745a6b', 2);
          pen.setLineDash([]);
          line(pen, ox, oy, footX, footY, '#643ba0', 4);
          const armLength = Math.hypot(footX - ox, footY - oy);
          if (armLength > 5) {
            const mark = Math.min(10, armLength / 2);
            const vx = (ox - footX) / armLength;
            const vy = (oy - footY) / armLength;
            const cornerX = footX + mark * (ux + vx);
            const cornerY = footY + mark * (uy + vy);
            line(pen, footX + mark * ux, footY + mark * uy, cornerX, cornerY, '#643ba0', 2);
            line(pen, cornerX, cornerY, footX + mark * vx, footY + mark * vy, '#643ba0', 2);
            pen.fillStyle = '#643ba0';
            pen.font = '700 21px system-ui';
            pen.fillText('d', (ox + footX) / 2 + 8, (oy + footY) / 2 + 24);
          }
        }
        spring(pen, x, y, headX - x, headY - y);
        if (hasTension) arrow(pen, x - 19 * uy, y + 19 * ux, ux * 31, uy * 31, '#a32d42');
        pen.font = '700 23px system-ui';
        pen.fillStyle = 'white';
        pen.fillText('O', ox - 8, 241);
        pen.beginPath();
        pen.arc(ox, oy, 6, 0, Math.PI * 2);
        pen.fill();
      }

      lab.dataset.beamAngle = tilt.toFixed(4);
      find('[data-turning-readout]').textContent = live ? 'Số đo lúc này' : 'Dự đoán ở vị trí ngang';
      find<HTMLOutputElement>('[data-turning-tension]').value = format.format(pull.tension) + ' N';
      find<HTMLOutputElement>('[data-turning-arm]').value = hasTension ? format.format(Math.abs(pull.arm)) + ' cm' : '—';
      find<HTMLOutputElement>('[data-turning-moment]').value = format.format(Math.abs(netTorque)) + ' N·m';
      find<HTMLOutputElement>('[data-turning-direction]').value = !netTorque
        ? 'Không có moment do lực kéo'
        : netTorque < 0 ? 'Ngược chiều kim đồng hồ' : 'Theo chiều kim đồng hồ';
      if (live && !hand) {
        const atStop = Math.abs(tilt) >= stopAngle;
        const message = atStop ? 'Thanh đang ở cữ chặn.'
          : !forceOn && Math.abs(speed) >= .012 ? 'Lực kéo đã về 0. Thanh đang quay chậm dần.'
          : !forceOn ? 'Lực kế đã nhả. Thanh đã dừng.'
          : 'Đang giữ lực đã đặt. Bấm Nhả lực để bỏ lực kéo.';
        if (status.textContent !== message) status.textContent = message;
      }
    }

    const beam = rotationLab((tilt) => live ? appliedForce(tilt).torque : 0, () => .48, render);

    function prepare() {
      live = false;
      forceOn = false;
      hand = null;
      reset.disabled = true;
      apply.textContent = 'Tác dụng lực đã đặt';
      status.textContent = 'Thanh ngang. Em có thể thử dự đoán trước khi kéo.';
      const distance = position.valueAsNumber;
      const side = distance === 0 ? 'Tại O' : Math.abs(distance) + ' cm bên ' + (distance < 0 ? 'trái O' : 'phải O');
      for (const [input, key, label] of [
        [force, 'force', force.value + ' N'], [position, 'position', side], [angle, 'angle', angle.value + '°'],
      ] as const) {
        find<HTMLOutputElement>('[data-turning-' + key + ']').value = label;
        input.setAttribute('aria-valuetext', label);
      }
      beam.reset();
    }

    function moveHook(value: number) {
      position.value = String(Math.max(-25, Math.min(50, value)));
      prepare();
    }
    dragHandle(hookHandle, canvas, (x) => moveHook(Math.round((x - ox) / pixelsPerCm / 5) * 5));
    hookHandle.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      moveHook(position.valueAsNumber + (event.key === 'ArrowLeft' ? -5 : 5));
    });

    function moveHand(x: number, y: number) {
      hand = { x: Math.max(18, Math.min(542, x)), y: Math.max(18, Math.min(332, y)) };
      beam.wake();
    }
    dragHandle(meterHandle, canvas,
      (x, y) => { if (hand) moveHand(x, y); },
      (x, y) => {
        live = true;
        forceOn = false;
        reset.disabled = false;
        apply.textContent = 'Tác dụng lực đã đặt';
        status.textContent = 'Đang kéo lực kế. Nhả tay để bỏ lực.';
        moveHand(x, y);
      },
      () => {
        if (!hand) return;
        hand = null;
        beam.wake();
      },
    );

    function toggleForce() {
      hand = null;
      live = true;
      forceOn = !forceOn;
      reset.disabled = false;
      apply.textContent = forceOn ? 'Nhả lực' : 'Tác dụng lực đã đặt';
      beam.wake();
    }
    apply.addEventListener('click', toggleForce);
    meterHandle.addEventListener('click', (event) => { if (event.detail === 0) toggleForce(); });
    reset.addEventListener('click', prepare);
    for (const input of [force, position, angle]) input.addEventListener('input', prepare);
    prepare();
    lab.hidden = false;
  }
</script>

<style>
  .measurement-lab .turning-figure { margin: 0; }
  .turning-figure .lab-board { max-width: 37rem; margin-inline: auto; }
</style>
