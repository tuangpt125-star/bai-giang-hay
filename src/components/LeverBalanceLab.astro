---
import '../styles/measurement-lab.css';
import '../styles/mechanics-lab.css';
---
<section class="measurement-lab mechanics-lab" data-lever-balance hidden aria-labelledby="lever-balance-title">
  <h3 id="lever-balance-title">Thí nghiệm ảo · Giữ đòn bẩy cân bằng</h3>
  <p class="mechanics-intro">Bấm <strong>Thả thanh</strong>, sau đó thử từng mức lực để xem đầu treo quả nặng nâng lên, hạ xuống hay giữ ngang.</p>
  <figure class="mechanics-board">
    <div class="lab-board">
      <canvas width="560" height="360" data-lever-diagram aria-hidden="true"></canvas>
      <button type="button" class="lab-grab" data-grab-weight aria-label="Quả nặng. Chạm để treo hoặc gỡ. Có thể kéo từ khay lên móc." title="Treo hoặc gỡ quả nặng"></button>
      <button type="button" class="lab-grab" data-grab-pressure data-grip-direction="↓" aria-label="Tay cầm. Chạm để thử lực. Giữ rồi di chuyển để tác dụng lực trực tiếp." title="Tác dụng lực tay"></button>
      <button type="button" class="lab-grab" data-grab-hand hidden aria-label="Vị trí đặt tay. Dùng phím trái hoặc phải để di chuyển." title="Đổi vị trí đặt tay"></button>
    </div>
  </figure>
  <div class="mechanics-actions">
    <button type="button" data-lever-unlock>Thả thanh</button>
    <button type="button" data-lever-toggle-weight data-secondary>Gỡ tải</button>
    <button type="button" data-lever-reset data-secondary disabled>Về ngang</button>
  </div>
  <p class="lab-trial-status mechanics-status" data-lever-trial role="status"></p>
  <div class="mechanics-trials">
    <p id="lever-level-label">Thử lực từ vị trí ngang</p>
    <div class="mechanics-levels" role="group" aria-labelledby="lever-level-label">
      {[6, 9, 12].map((value) => <button type="button" data-lever-level={value} aria-pressed="false">{value} N</button>)}
    </div>
  </div>
  <dl class="mechanics-measurements">
    <div><dt>Lực tay lúc này</dt><dd><output aria-live="off" data-lever-applied>0 N</output></dd></div>
    <div><dt>Trọng lượng quả nặng</dt><dd><output for="lever-load" data-lever-load>18 N</output></dd></div>
  </dl>
  <p class="lab-help mechanics-gesture">Em cũng có thể kéo quả nặng màu đỏ hoặc giữ tay cầm xanh rồi <strong data-lever-direction>ấn xuống</strong>.</p>
  <details class="mechanics-settings" data-lever-settings>
    <summary>Đổi cách bố trí, tải và lực thử</summary>
    <div class="lab-layout">
      <div class="lab-controls">
        <label for="lever-arrangement">Cách bố trí</label>
        <select id="lever-arrangement">
          <option value="opposite">Loại 1 · Điểm tựa nằm giữa</option>
          <option value="farther">Loại 2 · Đặt tay xa hơn tải</option>
          <option value="closer">Loại 2 · Đặt tay gần hơn tải</option>
        </select>
        <label for="lever-load">Trọng lượng quả nặng (N)</label>
        <input id="lever-load" type="range" min="6" max="36" step="3" value="18" />
        <label for="lever-effort-arm">Vị trí tay cách O <output for="lever-effort-arm" data-lever-effort-arm>40 cm</output></label>
        <input id="lever-effort-arm" type="range" min="10" max="60" step="10" value="40" />
        <p class="lab-help">Vị trí treo tải cách O <output data-lever-load-arm>20 cm</output>.</p>
      </div>
      <div class="lab-controls lab-panel">
        <label for="lever-trial-force">Lực tay muốn thử (N)</label>
        <div class="mechanics-force-entry">
          <input id="lever-trial-force" type="number" inputmode="decimal" min="0" max="150" step="0.1" value="6" required />
          <button type="button" data-lever-try>Thử lực này</button>
        </div>
        <details>
          <summary>Đối chiếu lực cân bằng</summary>
          <p>Khi tải đang treo, lực cân bằng là <output data-lever-effort>9 N</output>.</p>
        </details>
        <p class="lab-help">O là điểm tựa, P là trọng lượng tải, F là lực tay. Thanh có quán tính, ma sát ở trục và cữ chặn hai phía.</p>
      </div>
    </div>
  </details>
</section>

<script>
  import { arrow, dragHandle, line, positionHandle } from '../physics/lab-diagram';
  import { rotationLab, stopAngle, type Rotation } from '../physics/rotation';

  const format = new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 2 });
  const arrangements = {
    opposite: { loadArm: 20, min: 10, max: 60, initial: 40 },
    farther: { loadArm: 20, min: 30, max: 60, initial: 40 },
    closer: { loadArm: 40, min: 10, max: 30, initial: 20 },
  };
  const levelY = 165;
  const trayX = 54;
  const trayY = 309;
  const gripDistance = 74;
  const hangerLength = 21;

  for (const lab of document.querySelectorAll<HTMLElement>('[data-lever-balance]')) {
    const find = <T extends HTMLElement>(selector: string) => lab.querySelector<T>(selector)!;
    const arrangement = find<HTMLSelectElement>('#lever-arrangement');
    const load = find<HTMLInputElement>('#lever-load');
    const effortArm = find<HTMLInputElement>('#lever-effort-arm');
    const effort = find<HTMLInputElement>('#lever-trial-force');
    const canvas = find<HTMLCanvasElement>('[data-lever-diagram]');
    const context = canvas.getContext('2d');
    const handle = find<HTMLButtonElement>('[data-grab-hand]');
    const weightHandle = find<HTMLButtonElement>('[data-grab-weight]');
    const pressureHandle = find<HTMLButtonElement>('[data-grab-pressure]');
    const reset = find<HTMLButtonElement>('[data-lever-reset]');
    const apply = find<HTMLButtonElement>('[data-lever-try]');
    const toggleWeight = find<HTMLButtonElement>('[data-lever-toggle-weight]');
    const unlock = find<HTMLButtonElement>('[data-lever-unlock]');
    const applied = find<HTMLOutputElement>('[data-lever-applied]');
    const trial = find<HTMLElement>('[data-lever-trial]');
    const settingsPanel = find<HTMLDetailsElement>('[data-lever-settings]');
    const levels = lab.querySelectorAll<HTMLButtonElement>('[data-lever-level]');
    let locked = true;
    let holding = false;
    let attached = true;
    let gripY: number | null = null;
    let gripOffset = 0;
    let carried: { x: number; y: number; wasAttached: boolean } | null = null;

    if (!context) canvas.closest('figure')!.hidden = true;

    function settings() {
      const mode = arrangement.value as keyof typeof arrangements;
      return arrangements[mode];
    }

    function oppositeSide() { return arrangement.value === 'opposite'; }
    function pivotX() { return oppositeSide() ? 278 : 86; }
    function pixelsPerCm() { return oppositeSide() ? 3.65 : 6.1; }

    function beamPoint(distance: number, tilt: number) {
      const offset = distance * pixelsPerCm();
      return { x: pivotX() + offset * Math.cos(tilt), y: levelY + offset * Math.sin(tilt) };
    }
    function loadPoint(tilt: number) {
      return beamPoint(settings().loadArm * (oppositeSide() ? -1 : 1), tilt);
    }
    function handForce(tilt: number) {
      if (gripY === null) return holding && effort.validity.valid ? effort.valueAsNumber : 0;
      const neutralY = beamPoint(effortArm.valueAsNumber, tilt).y - gripDistance;
      const displacement = (gripY - neutralY) * (oppositeSide() ? 1 : -1);
      return Math.min(36, Math.max(0, displacement * .65));
    }
    function momentDifference(tilt: number) {
      const loadMoment = attached ? load.valueAsNumber * settings().loadArm : 0;
      const handMoment = handForce(tilt) * effortArm.valueAsNumber;
      return (loadMoment - handMoment) * Math.cos(tilt) / 100;
    }

    function inDropZone(x: number, y: number, hook: { x: number; y: number }) {
      return Math.hypot(x - hook.x, y - hook.y - hangerLength) < 58;
    }

    function draw({ angle: tilt, speed }: Rotation) {
      const pen = context;
      const pivot = pivotX();
      const left = oppositeSide() ? -37 : -6;
      const right = oppositeSide() ? 63 : 66;
      const loadHook = loadPoint(tilt);
      const handHook = beamPoint(effortArm.valueAsNumber, tilt);
      const weightWidth = 25 + load.valueAsNumber / 3;
      const weightHeight = weightWidth * .8;
      const weightX = carried?.x ?? (attached ? loadHook.x : trayX);
      const weightY = carried?.y ?? (attached ? loadHook.y + hangerLength + weightHeight / 2 : trayY);
      const force = handForce(tilt);
      const neutralY = handHook.y - gripDistance;
      const shownGripY = gripY ?? neutralY;
      const difference = momentDifference(tilt);
      const atStop = Math.abs(tilt) >= stopAngle;
      const readyToHang = Boolean(carried) && inDropZone(weightX, weightY, loadHook);
      const weightState = attached ? 'Tải đang treo.' : 'Tải ở trong khay.';
      const towardLoad = difference > 0;
      const pushingStop = atStop && Math.sign(tilt) === Math.sign(difference) * (oppositeSide() ? -1 : 1);
      const motion = locked ? 'Thanh được giữ ngang.'
        : Math.abs(difference) < .005 ? (Math.abs(speed) >= .012 ? 'Thanh đang chậm dần.' : attached ? 'Đòn bẩy cân bằng.' : 'Thanh đứng yên.')
        : pushingStop ? (towardLoad ? 'Đầu treo tải đã hạ tới cữ chặn.' : 'Đầu treo tải đã nâng tới cữ chặn.')
        : towardLoad ? 'Đầu treo tải hạ xuống.' : 'Đầu treo tải nâng lên.';
      const status = carried ? (readyToHang ? 'Thả tay để treo quả nặng.' : 'Đưa quả nặng vào vòng gần móc để treo.') : weightState + ' ' + motion;
      if (trial.textContent !== status) trial.textContent = status;
      const forceLabel = format.format(force) + ' N';
      if (applied.value !== forceLabel) applied.value = forceLabel;
      lab.dataset.beamAngle = tilt.toFixed(4);
      lab.dataset.leverWeightState = carried ? 'held' : attached ? 'attached' : 'tray';
      handle.hidden = !settingsPanel.open || gripY !== null;
      positionHandle(handle, canvas, handHook.x, handHook.y);
      positionHandle(weightHandle, canvas, weightX, weightY);
      positionHandle(pressureHandle, canvas, handHook.x, shownGripY);
      if (!pen) return;

      pen.clearRect(0, 0, canvas.width, canvas.height);
      pen.lineCap = 'round';
      line(pen, 20, 337, 538, 337, '#c7d3e2', 4);
      for (const stop of [left + 1, right - 1]) {
        const point = beamPoint(stop, Math.sign(stop) * stopAngle);
        line(pen, point.x, point.y + 8, point.x, 333, '#a17555', 9);
      }
      line(pen, trayX - 37, trayY + 17, trayX + 37, trayY + 17, '#70819a', 7);
      pen.font = '650 17px system-ui';
      pen.fillStyle = '#4c5d75';
      pen.fillText('Khay tải', trayX - 31, trayY - 29);
      pen.fillStyle = '#624296';
      pen.beginPath();
      pen.moveTo(pivot, levelY);
      pen.lineTo(pivot - 43, 334);
      pen.lineTo(pivot + 43, 334);
      pen.closePath();
      pen.fill();

      const start = beamPoint(left, tilt);
      const end = beamPoint(right, tilt);
      line(pen, start.x, start.y, end.x, end.y, '#526887', 15);
      line(pen, start.x, start.y - 3, end.x, end.y - 3, '#8194ae', 3);
      pen.fillStyle = '#e0e7ef';
      for (let offset = Math.ceil(left / 10) * 10; offset < right; offset += 10) {
        const point = beamPoint(offset, tilt);
        pen.beginPath();
        pen.arc(point.x, point.y, 3, 0, Math.PI * 2);
        pen.fill();
      }

      if (carried) {
        pen.beginPath();
        pen.arc(loadHook.x, loadHook.y + hangerLength, 25, 0, Math.PI * 2);
        pen.fillStyle = readyToHang ? '#b9e4ce' : '#ffffff';
        pen.fill();
        pen.strokeStyle = '#356950';
        pen.lineWidth = 2.5;
        pen.setLineDash(readyToHang ? [] : [5, 4]);
        pen.stroke();
        pen.setLineDash([]);
      }
      pen.strokeStyle = '#a64758';
      pen.lineWidth = 3;
      pen.beginPath();
      pen.arc(loadHook.x, loadHook.y + 8, 8, 0, Math.PI * 2);
      pen.stroke();
      if (attached) {
        line(pen, loadHook.x, loadHook.y + 14, weightX, weightY - weightHeight / 2, '#485667', 3);
        arrow(pen, loadHook.x, weightY + weightHeight / 2 + 7, 0, 25, '#9e3044');
        pen.font = '700 20px system-ui';
        pen.fillStyle = '#743244';
        pen.fillText('P', weightX + 12, weightY + weightHeight / 2 + 30);
      }
      pen.strokeStyle = '#6d3341';
      pen.lineWidth = 2.5;
      pen.beginPath();
      pen.arc(weightX, weightY - weightHeight / 2 - 4, 5, 0, Math.PI * 2);
      pen.stroke();
      pen.fillStyle = '#a64758';
      pen.beginPath();
      pen.roundRect(weightX - weightWidth / 2, weightY - weightHeight / 2, weightWidth, weightHeight, 4);
      pen.fill();

      line(pen, handHook.x, handHook.y - 8, handHook.x, shownGripY, '#145e52', 3);
      line(pen, handHook.x - 11, shownGripY, handHook.x + 11, shownGripY, '#8cc9b1', 9);
      if (force > .005) {
        const direction = oppositeSide() ? 1 : -1;
        const length = Math.min(42, 15 + force * .8);
        arrow(pen, handHook.x + 15, handHook.y - 28 - direction * length / 2, 0, direction * length, '#145e52');
        pen.font = '700 20px system-ui';
        pen.fillStyle = '#145e52';
        pen.fillText('F', handHook.x + 29, handHook.y - 23);
      }
      pen.fillStyle = 'white';
      pen.font = '700 23px system-ui';
      pen.fillText('O', pivot - 9, levelY + 55);
      pen.beginPath();
      pen.arc(pivot, levelY, 5, 0, Math.PI * 2);
      pen.fill();
    }

    const beam = rotationLab(
      (tilt) => locked ? 0 : momentDifference(tilt) * (oppositeSide() ? -1 : 1),
      () => .55 + (attached ? load.valueAsNumber / 9.81 * (settings().loadArm / 100) ** 2 : 0),
      draw,
    );

    function update() {
      const weight = load.valueAsNumber;
      const distance = effortArm.valueAsNumber;
      const model = settings();
      const loadLabel = weight + ' N';
      const distanceLabel = distance + ' cm';
      load.setAttribute('aria-valuetext', loadLabel);
      effortArm.setAttribute('aria-valuetext', distanceLabel);
      find<HTMLOutputElement>('[data-lever-load]').value = loadLabel;
      find<HTMLOutputElement>('[data-lever-effort-arm]').value = distanceLabel;
      find<HTMLOutputElement>('[data-lever-load-arm]').value = model.loadArm + ' cm';
      find<HTMLOutputElement>('[data-lever-effort]').value = format.format(weight * model.loadArm / distance) + ' N';
      find('[data-lever-direction]').textContent = oppositeSide() ? 'ấn xuống' : 'kéo lên';
      pressureHandle.dataset.gripDirection = oppositeSide() ? '↓' : '↑';
      toggleWeight.textContent = attached ? 'Gỡ tải' : 'Treo tải';
      unlock.textContent = holding || gripY !== null ? 'Nhả lực tay' : 'Thả thanh';
      unlock.disabled = !locked && !holding && gripY === null;
      reset.disabled = locked;
      for (const level of levels) {
        level.setAttribute('aria-pressed', String(holding && effort.validity.valid && effort.value === level.dataset.leverLevel));
      }
      beam.wake();
    }

    function moveHand(distance: number) {
      const { min, max } = settings();
      effortArm.value = String(Math.max(min, Math.min(max, distance)));
      update();
    }
    dragHandle(handle, canvas, {
      move(x, y) {
        const { angle: tilt } = beam.state;
        const distance = ((x - pivotX()) * Math.cos(tilt) + (y - levelY) * Math.sin(tilt)) / pixelsPerCm();
        moveHand(Math.round(distance / 10) * 10);
      },
    });
    handle.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      moveHand(effortArm.valueAsNumber + (event.key === 'ArrowLeft' ? -10 : 10));
    });

    function setGrip(y: number) {
      gripY = Math.min(342, Math.max(18, y));
      update();
    }
    dragHandle(pressureHandle, canvas, {
      move(_, y) {
        if (gripY === null) return;
        setGrip(y - gripOffset);
        if (locked && handForce(beam.state.angle) > .05) releaseBeam();
      },
      start(_, y) {
        holding = false;
        const neutralY = beamPoint(effortArm.valueAsNumber, beam.state.angle).y - gripDistance;
        gripOffset = y - neutralY;
        setGrip(neutralY);
      },
      end() {
        gripY = null;
        update();
      },
      tap() {
        if (holding) releaseForce();
        else tryForce();
      },
    });

    function carryWeight(x: number, y: number) {
      if (!carried) return;
      carried.x = Math.min(542, Math.max(18, x));
      carried.y = Math.min(337, Math.max(18, y));
      beam.wake();
    }
    dragHandle(weightHandle, canvas, {
      move: carryWeight,
      start(x, y) {
        carried = { x, y, wasAttached: attached };
        attached = false;
        update();
      },
      end(cancelled) {
        if (!carried) return;
        const hook = loadPoint(beam.state.angle);
        attached = cancelled ? carried.wasAttached : inDropZone(carried.x, carried.y, hook);
        carried = null;
        update();
      },
      tap: changeWeight,
    });

    function releaseBeam() {
      locked = false;
      update();
    }

    function changeWeight() {
      if (carried) return;
      attached = !attached;
      update();
    }

    function releaseForce() {
      holding = false;
      gripY = null;
      releaseBeam();
    }

    function tryForce() {
      if (!effort.validity.valid) {
        settingsPanel.open = true;
        effort.reportValidity();
        return;
      }
      gripY = null;
      holding = true;
      locked = false;
      beam.reset();
      update();
    }

    function secureBeam() {
      locked = true;
      holding = false;
      gripY = null;
      beam.reset();
      update();
    }

    apply.addEventListener('click', tryForce);
    for (const level of levels) {
      level.addEventListener('click', () => {
        effort.value = level.dataset.leverLevel!;
        tryForce();
      });
    }
    toggleWeight.addEventListener('click', changeWeight);
    unlock.addEventListener('click', releaseForce);
    reset.addEventListener('click', secureBeam);
    settingsPanel.addEventListener('toggle', () => beam.wake());
    effort.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      tryForce();
    });
    arrangement.addEventListener('change', () => {
      const model = settings();
      effortArm.min = String(model.min);
      effortArm.max = String(model.max);
      effortArm.value = String(model.initial);
      carried = null;
      secureBeam();
    });
    for (const input of [load, effort, effortArm]) input.addEventListener('input', update);
    update();
    lab.hidden = false;
  }
</script>
