---
import type { MarkdownHeading } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import Shell from '../../../../layouts/Shell.astro';
import Icon from '../../../../components/Icon.astro';
import CircuitDiagram from '../../../../components/CircuitDiagram.astro';
import ReflectionDiagram from '../../../../components/ReflectionDiagram.astro';
import PressureSetups from '../../../../components/PressureSetups.astro';
import PressureSimulation from '../../../../components/PressureSimulation.astro';
import DistanceTimeSimulation from '../../../../components/DistanceTimeSimulation.astro';
import PhetActivity from '../../../../components/PhetActivity.astro';
import { bookRoute, books, catalogUrl, lessonId, lessonUrl, lessonWorkspaceUrl, loadBookLessons, physicsLessons, type Book, type Chapter, type Lesson } from '../../../../book';

export async function getStaticPaths() {
  const entries = await loadBookLessons();
  return books.flatMap((book) => {
    const lessons = physicsLessons(book);
    return lessons.map((lesson, index) => ({
      params: { ...bookRoute(book), lesson: lesson.slug },
      props: { book, lesson, index, entry: entries.get(lessonId(book, lesson)) },
    }));
  });
}

interface Props {
  book: Book;
  lesson: Lesson & { chapter: Chapter };
  index: number;
  entry?: CollectionEntry<'lessons'>;
}

const { book, lesson, index, entry } = Astro.props;
const lessons = physicsLessons(book);
const catalogue = catalogUrl(book);
const reading = entry ? await render(entry) : null;
const Content = reading?.Content;
const allHeadings: MarkdownHeading[] = reading?.headings ?? [];
const headings = allHeadings.filter((heading) => heading.depth === 2);
const previous = lessons[index - 1];
const next = lessons[index + 1];
const showSimulation = book.grade === 8 && lesson.slug === 'ap-suat-tren-mot-be-mat';
const circuitLesson = book.grade === 8 && lesson.slug === 'mach-dien-don-gian';
const circuitMeasurement = book.grade === 8 && (
  lesson.slug === 'cuong-do-dong-dien-va-hieu-dien-the' ||
  lesson.slug === 'thuc-hanh-do-cuong-do-dong-dien-va-hieu-dien-the'
);
const densityCover = book.grade === 8 && lesson.slug === 'khoi-luong-rieng';
const pages = lesson.pages[0] === lesson.pages[1] ? lesson.pages[0] : lesson.pages.join('–');
---
<Shell book={book} title={`Bài ${lesson.number}. ${lesson.title}`} currentChapter={lesson.chapter.id} currentLesson={`Bài ${lesson.number}`}>
  <div class="reading">
    <a class="back-link reading-back" href={`${catalogue}#${lesson.chapter.id}`}>‹ Mục lục chương {lesson.chapter.number}</a>
    <header class:list={['reading-header', { 'has-cover': densityCover }]}>
      <div class="reading-heading">
        <p class="reading-chapter">Chương {lesson.chapter.number} · {lesson.chapter.title}</p>
        <h1>{lesson.title}</h1>
        <p class="reading-meta">Bài {lesson.number} <span aria-hidden="true">·</span> SGK trang {pages}</p>
        <a class="workspace-link" href={lessonWorkspaceUrl(book, lesson)}>Soạn giáo án hoặc slide cho bài này</a>
      </div>
      {densityCover && (
        <figure class="reading-visual">
          <img src={`${import.meta.env.BASE_URL}images/khoi-luong-rieng.webp`} width="900" height="600"
            alt="Ảnh minh họa ba trụ kim loại cao dần đặt cạnh cân điện tử" fetchpriority="high" />
        </figure>
      )}
    </header>
    <div class:list={['reading-grid', { 'has-text': Content }]}>
      {Content ? (
        <>
          <nav class="in-this-lesson" aria-label="Các mục trong bài">
            <details open data-reading-toc>
              <summary>Trong bài này</summary>
              <ul>{headings.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}</ul>
            </details>
          </nav>
          <article class="lesson-text"><Content /></article>
        </>
      ) : (
        <section class="pending-reading">
          <span class="featured-icon"><Icon name="book" size={25} /></span>
          <div>
            <h2>Bài đọc đang được chuẩn bị</h2>
            <a class="back-link" href={`${catalogue}#${lesson.chapter.id}`}>Về mục lục chương {lesson.chapter.number}</a>
          </div>
        </section>
      )}
    </div>
    {!Content && showSimulation && <><PressureSetups /><PressureSimulation /></>}
    {circuitLesson && <CircuitDiagram />}
    {book.grade === 7 && lesson.slug === 'do-thi-quang-duong-thoi-gian' && <DistanceTimeSimulation />}
    {book.grade === 8 && lesson.slug === 'luc-day-archimedes' && (
      <PhetActivity
        title="Thí nghiệm ảo · Lực đẩy Archimedes"
        simulation="buoyancy-basics"
        tasks={[
          'Bật hiển thị các lực. Dự đoán lực đẩy sẽ thay đổi thế nào khi nhúng vật sâu dần vào nước.',
          'Kéo một khối ngập một phần rồi ngập hoàn toàn. Quan sát mũi tên lực đẩy hướng lên khi phần chìm tăng.',
          'Giữ khối ngập hoàn toàn và kéo xuống sâu hơn, tránh chạm đáy. So sánh mũi tên lực đẩy ở hai độ sâu.',
        ]}
        question="Khi vật đã ngập hoàn toàn trong cùng chất lỏng, thay đổi độ sâu có làm thay đổi thể tích phần chìm và lực đẩy không?"
      />
    )}
    {(circuitLesson || circuitMeasurement) && (
      <PhetActivity
        title={circuitLesson ? 'Thí nghiệm ảo · Lắp mạch làm sáng đèn' : 'Thí nghiệm ảo · Đo dòng điện và hiệu điện thế'}
        simulation="circuit-construction-kit-dc-virtual-lab"
        tasks={circuitLesson ? [
          'Kéo pin, bóng đèn và công tắc ra bàn thí nghiệm. Dùng dây dẫn nối chúng thành một vòng.',
          'Dự đoán trạng thái của đèn khi mở và khi đóng công tắc. Thử cả hai trường hợp để kiểm tra.',
        ] : [
          'Lắp một mạch kín gồm pin, công tắc và bóng đèn.',
          'Ngắt dây tại một vị trí trên vòng mạch và mắc ampe kế nối tiếp vào chỗ ngắt. Đóng công tắc, đọc số chỉ theo ampe (A).',
          'Đặt hai que vôn kế vào hai đầu bóng đèn. Đọc số chỉ theo vôn (V) và ghi lại cùng số đo cường độ dòng điện.',
        ]}
        question={circuitLesson
          ? 'Khi mở công tắc, vòng mạch thay đổi thế nào và vì sao đèn tắt?'
          : 'Nếu chuyển ampe kế sang phía còn lại của đèn trong cùng vòng mạch, số chỉ có đổi không? Hãy đo để kiểm tra.'}
      />
    )}
    {!Content && book.grade === 7 && lesson.slug === 'su-phan-xa-anh-sang' && <ReflectionDiagram />}
    <nav class="lesson-navigation" aria-label="Chuyển bài">
      {previous && <a href={lessonUrl(book, previous)}><small>Bài trước · {previous.number}</small><strong>{previous.title}</strong></a>}
      {next && <a href={lessonUrl(book, next)}><small>Bài sau · {next.number}</small><strong>{next.title}</strong></a>}
    </nav>
  </div>
</Shell>

<script>
  const toc = document.querySelector<HTMLDetailsElement>('[data-reading-toc]');
  if (toc && matchMedia('(max-width: 700px)').matches) toc.open = false;
</script>
