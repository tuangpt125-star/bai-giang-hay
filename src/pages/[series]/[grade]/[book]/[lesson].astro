---
import type { MarkdownHeading } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import Shell from '../../../../layouts/Shell.astro';
import Icon from '../../../../components/Icon.astro';
import PressureSimulation from '../../../../components/PressureSimulation.astro';
import { bookRoute, books, catalogUrl, lessonId, lessonUrl, loadBookLessons, physicsLessons, type Book, type Chapter, type Lesson } from '../../../../book';

export async function getStaticPaths() {
  const entries = await loadBookLessons();
  return books.flatMap((book) => {
    const lessons = physicsLessons(book);
    return lessons.map((lesson, index) => ({
      params: { ...bookRoute(book), lesson: lesson.slug },
      props: { book, lesson, index, entry: entries.get(lessonId(book, lesson)) },
    }));
  });
}

interface Props {
  book: Book;
  lesson: Lesson & { chapter: Chapter };
  index: number;
  entry?: CollectionEntry<'lessons'>;
}

const { book, lesson, index, entry } = Astro.props;
const lessons = physicsLessons(book);
const catalogue = catalogUrl(book);
const reading = entry ? await render(entry) : null;
const Content = reading?.Content;
const allHeadings: MarkdownHeading[] = reading?.headings ?? [];
const headings = allHeadings.filter((heading) => heading.depth === 2);
const previous = lessons[index - 1];
const next = lessons[index + 1];
const showSimulation = book.grade === 8 && lesson.slug === 'ap-suat-tren-mot-be-mat';
const pages = lesson.pages[0] === lesson.pages[1] ? lesson.pages[0] : lesson.pages.join('–');
---
<Shell book={book} title={`Bài ${lesson.number}. ${lesson.title}`} currentChapter={lesson.chapter.id} currentLesson={`Bài ${lesson.number}`}>
  <div class="reading">
    <a class="back-link" href={`${catalogue}#${lesson.chapter.id}`}>Mục lục chương {lesson.chapter.number}</a>
    <header class="reading-header">
      <p class="reading-meta">Bài {lesson.number} <span aria-hidden="true">·</span> Trang {pages} trong sách</p>
      <h1>{lesson.title}</h1>
    </header>
    <div class:list={['reading-grid', { 'has-text': Content }]}>
      {Content ? (
        <>
          <nav class="in-this-lesson" aria-label="Các mục trong bài">
            <strong>Trong bài này</strong>
            <ul>{headings.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}</ul>
          </nav>
          <article class="lesson-text"><Content /></article>
        </>
      ) : (
        <section class="pending-reading">
          <span class="featured-icon"><Icon name="book" size={25} /></span>
          <div>
            <h2>Bài đọc đang được chuẩn bị</h2>
            <a class="back-link" href={`${catalogue}#${lesson.chapter.id}`}>Về mục lục chương {lesson.chapter.number}</a>
          </div>
        </section>
      )}
    </div>
    {!Content && showSimulation && <PressureSimulation />}
    <nav class="lesson-navigation" aria-label="Chuyển bài">
      {previous && <a href={lessonUrl(book, previous)}><small>Bài trước · {previous.number}</small><strong>{previous.title}</strong></a>}
      {next && <a href={lessonUrl(book, next)}><small>Bài sau · {next.number}</small><strong>{next.title}</strong></a>}
    </nav>
  </div>
</Shell>
