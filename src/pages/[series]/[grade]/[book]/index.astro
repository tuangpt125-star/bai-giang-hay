---
import BookCatalog from '../../../../components/BookCatalog.astro';
import { bookRoute, books, defaultBook, type Book } from '../../../../book';

export function getStaticPaths() {
  return books.filter((book) => book !== defaultBook).map((book) => ({
    params: bookRoute(book),
    props: { book },
  }));
}

interface Props { book: Book }
const { book } = Astro.props;
---
<BookCatalog book={book} />
